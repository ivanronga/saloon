# Local preview needs no variables (embedded PGlite in .data/).
# Production (Vercel + Neon): set DATABASE_URL (Neon pooled connection string) in Vercel.
# DATABASE_URL=postgres://...
# First-time setup of that database (run once from your PC, see README "Deploy"):
#   npm run migrate && npm run seed && npm run create-admin

# Public origin for canonical/hreflang/sitemap URLs (production: your real domain, no trailing slash)
SITE_URL=http://localhost:3000
